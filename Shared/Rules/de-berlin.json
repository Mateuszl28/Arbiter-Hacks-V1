      "materials": ["en:metal"],
      "stream": "gelbe",
      "instruction": "Metal packaging goes in the yellow bin.",
      "caution": null
    },
    {
      "materials": ["en:composite-material"],
      "stream": "gelbe",
      "instruction": "Flatten the carton — yellow bin, with the packaging.",
      "caution": null
    },
    {
      "materials": ["en:paper-or-cardboard"],
      "stream": "blaue",
      "instruction": "Flatten it and keep it dry.",
      "caution": null
    },
    {
      "materials": ["en:clear-glass"],
      "stream": "weissglas",
      "instruction": "Clear glass has its own container. Caps off.",
      "caution": null
    },
    {
      "materials": ["en:green-glass", "en:brown-glass"],
      "stream": "buntglas",
      "instruction": "Green and brown glass share the coloured container. Caps off.",
      "caution": null
    },
    {
      "materials": ["en:glass"],
      "stream": "buntglas",
      "instruction": "Caps off, then into the coloured glass container.",
      "caution": "Berlin sorts glass by colour. If you cannot tell the colour, coloured glass is the safe choice."
    },
    {
      "materials": ["en:pla-polylactic-acid", "en:biobased-plastic"],
      "stream": "hausmuell",
      "instruction": "Residual waste.",
      "caution": "Compostable plastics are rejected by the Biogut process here — they do not break down fast enough."
    },
    {
