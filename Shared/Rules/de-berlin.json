      "instruction": "Drinks cans carry a deposit. Return it to a shop for 25 cents.",
      "caution": "Keep it intact — a crushed can is often rejected by the machine."
    },
    {
      "materials": ["en:plastic"],
      "stream": "gelbe",
      "instruction": "Empty it and drop it in the yellow bin. No need to rinse.",
      "caution": null
    },
